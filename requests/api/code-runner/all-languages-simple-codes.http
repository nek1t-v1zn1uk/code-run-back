// Testing simple codes in every available language

### С
POST {{server}}/api/v1/code-execution
Content-Type: application/json

{
  "code" : "#include <stdio.h>\nint main() { int a, b;scanf(\"%d %d\", &a, &b);printf(\"%d\", a + b); }",
  "input": "2 3",
  "language": "c"
}

### С++
POST {{server}}/api/v1/code-execution
Content-Type: application/json

{
  "code" : "#include <iostream>\nusing namespace std; int main() { int a, b; cin >> a >> b;cout << a + b << endl; }",
  "input": "2 3",
  "language": "cpp"
}

### Python
POST {{server}}/api/v1/code-execution
Content-Type: application/json

{
  "code" : "import sys\nline = sys.stdin.read()\nif line:\n    a, b = map(int, line.split())\n    print(a + b)",
  "input": "2 3",
  "language": "python"
}

### Kotlin
POST {{server}}/api/v1/code-execution
Content-Type: application/json

{
  "code" : "fun main() { val (a, b) = readln().split(' ').map { it.toInt() }\nprintln(a + b) }",
  "input": "2 3",
  "language": "kotlin"
}
