### Creating problem
POST {{server}}/api/v1/problems
Content-Type: application/json
Authorization: Bearer {{auth.token}}

{
  "title": "New problem",
  "topic": "Basic algorithms",
  "difficulty": "MEDIUM",
  "statement": "Statement is big enough",
  "execution_time_limit_ms": 1000,
  "execution_memory_limit_kb": 1024,
  "default_evaluation_type": "EXACT_MATCH"
}

### Updating problem
PATCH {{server}}/api/v1/problems/1
Content-Type: application/json
Authorization: Bearer {{auth.token}}

{
  "title": "New problem 2",
  "topic": "Basic algorithms",
  "difficulty": "HARD",
  "statement": "Statement is big enough 2",
  "execution_time_limit_ms": 2000,
  "execution_memory_limit_kb": 3072,
  "default_evaluation_type": "SCRIPT_CHECK"
}

### Deleting problem
DELETE {{server}}/api/v1/problems/1
Authorization: Bearer {{auth.token}}

### Updating list of tests
POST {{server}}/api/v1/problems/8/tests
Content-Type: application/json
Authorization: Bearer {{auth.token}}

{
    "new_tests": [
      {
        "ordinal": 2,
        "is_example": true,
        "input_data": "24",
        "expected_output": "2 4"
      },
      {
        "ordinal": 3,
        "is_example": false,
        "input_data": "11",
        "expected_output": "1 1"
      }
    ],
    "update_tests": [
      {
        "id": 4,
        "ordinal": 1
      }
    ],
    "delete_tests": [
      {
        "id": 3
      }
    ]
}